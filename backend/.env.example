# Copy this file to .env and fill in the values
# cp .env.example .env

# -- App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# -- Database
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/aurum-main

# -- Auth (change in prod!)
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRY_MINUTES=60

# -- PII Encryption (generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=

# -- SEBI
MIN_INVESTMENT_INR=5000000

# -- Public app URL
APP_BASE_URL=http://localhost:5173

# -- Email (Gmail SMTP)
#    Generate an App Password at https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx
SMTP_FROM=Aurum PMS <your-email@gmail.com>
SMTP_USE_TLS=true

# -- WhatsApp Cloud API (OTP delivery)
#    Setup: https://developers.facebook.com -> Create App -> Add WhatsApp product
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_OTP_TEMPLATE_NAME=aurum_otp

# -- SMS fallback (MSG91, optional)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AURUMP
MSG91_ROUTE=4
OTP_TTL_MINUTES=10

# -- Mock OTP (dev/demo only - remove in production)
MOCK_OTP_PHONES=+919999999999,+918888888888
MOCK_OTP_CODE=123456
