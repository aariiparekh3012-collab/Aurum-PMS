# ── App
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# ── Database
DATABASE_URL=postgresql://pms:pms@localhost:5432/pms

# ── Auth (change in prod!)
JWT_SECRET=dev-secret-change-me-in-production
JWT_EXPIRY_MINUTES=60

# ── PII Encryption (generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
FERNET_KEY=your-fernet-key-here

# ── SEBI
MIN_INVESTMENT_INR=5000000

# ── External Services (sandbox URLs)
BANK_VERIFY_BASE_URL=https://sandbox.bankverify.example.com
BANK_VERIFY_API_KEY=
KYC_BASE_URL=https://sandbox.kra.example.com
KYC_API_KEY=
ESIGN_BASE_URL=https://sandbox.esign.example.com
ESIGN_API_KEY=

# ── Public app URL (used to build verification links emailed to users)
APP_BASE_URL=http://localhost:5173

# ── Email / SMTP  (leave SMTP_HOST blank in dev → links print to the server log)
#    Gmail example: host=smtp.gmail.com port=587, user=you@gmail.com,
#    password = a Google "App Password" (not your normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aurum PMS <no-reply@aurumpms.com>
SMTP_USE_TLS=true

# ── SMS / OTP via MSG91  (leave MSG91_AUTH_KEY blank in dev → OTP prints to the server log)
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AURUMP
MSG91_ROUTE=4
OTP_TTL_MINUTES=10
