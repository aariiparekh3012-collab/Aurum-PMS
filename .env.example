# ══════════════════════════════════════════════════════════════════════════════
# Aurum PMS — Environment Variables
# Copy to .env and fill in values. NEVER commit .env to git.
# ══════════════════════════════════════════════════════════════════════════════

# ─── Database ────────────────────────────────────────────────────────────────
# Local dev: used by docker-compose.yml
DATABASE_URL=postgresql://pms_admin:localdev123@localhost:5432/pms
NSE_DATABASE_URL=postgresql://postgres:aarya123@localhost:5432/downloaddailyreport
DB_PASSWORD=localdev123
# Production: set DB_PASSWORD to something strong and let docker-compose.prod.yml build DATABASE_URL
# Or override DATABASE_URL directly for managed DBs (Neon, Supabase, RDS):
#   DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# ─── Security — CHANGE ALL OF THESE IN PRODUCTION ────────────────────────────
# Generate JWT_SECRET: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=dev-secret-change-in-production-min-32-chars
# Generate PII_ENCRYPTION_KEY: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PII_ENCRYPTION_KEY=B5xHl5YOlKrJcE5S_YN3bKl3-5FlrZY7-X3l0Uv5qQo=

# ─── App ─────────────────────────────────────────────────────────────────────
# Set to "production" on public servers — disables /auth/dev-token endpoint
ENVIRONMENT=local
# Comma-separated list of allowed frontend origins (no trailing slash)
# Production example: https://yourdomain.com,https://www.yourdomain.com
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── Gunicorn workers (production only) ──────────────────────────────────────
# Formula: 2 * CPU_cores + 1  (3 is safe for a 1-core VPS)
WORKERS=3

# ─── External APIs (leave blank for local dev — uses fakes) ──────────────────
# Legacy settings (kept for backward compat)
KRA_BASE_URL=
KRA_API_KEY=
CKYC_BASE_URL=
CKYC_API_KEY=
ESIGN_BASE_URL=
ESIGN_API_KEY=
BANK_VERIFY_BASE_URL=
BANK_VERIFY_API_KEY=

# ─── Surepass — PAN verification + penny-drop bank verification ─────────────
# Get API token at https://surepass.io/get-api-key/
# Sandbox: https://sandbox.surepass.io/api/v1  |  Prod: https://kyc-api.surepass.io/api/v1
SUREPASS_BASE_URL=https://kyc-api.surepass.io/api/v1
SUREPASS_API_TOKEN=

# ─── Digio — Aadhaar eSign ──────────────────────────────────────────────────
# Get credentials from Digio dashboard
# Sandbox: https://ext.digio.in  |  Prod: https://api.digio.in
DIGIO_BASE_URL=https://ext.digio.in
DIGIO_CLIENT_ID=
DIGIO_CLIENT_SECRET=

# ─── Document Storage ──────────────────────────────────────────────────────
# Backend: "local" (filesystem) or "s3" (S3/MinIO)
DOCUMENT_STORAGE_BACKEND=local
# Local storage path (relative to backend/, used when backend=local)
DOCUMENT_STORAGE_PATH=document_uploads
# S3/MinIO settings (used when backend=s3)
DOCUMENT_S3_BUCKET=pms-documents
DOCUMENT_S3_ENDPOINT=http://localhost:9000
DOCUMENT_S3_ACCESS_KEY=
DOCUMENT_S3_SECRET_KEY=
DOCUMENT_S3_REGION=ap-south-1

# ─── Email — SendGrid (preferred) or SMTP fallback ─────────────────────────
# Leave SENDGRID_API_KEY blank to fall back to SMTP; leave both blank for console logging.
# Get API key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=no-reply@aurumpms.com
SENDGRID_FROM_NAME=Aurum PMS

# SMTP fallback (used if SendGrid key is blank)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Aurum PMS <no-reply@aurumpms.com>
SMTP_USE_TLS=true

# ─── SMS — MSG91 (India, DLT-compliant) ────────────────────────────────────
# Leave MSG91_AUTH_KEY blank to log SMS to console in dev.
# Get auth key at https://msg91.com/
MSG91_AUTH_KEY=
MSG91_SENDER_ID=AURUMP
MSG91_ROUTE=4
# DLT-approved template ID for transactional SMS (required in production)
MSG91_TEMPLATE_ID=
OTP_TTL_MINUTES=10

# ─── Redis (event bus) ──────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
